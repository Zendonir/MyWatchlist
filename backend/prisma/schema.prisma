datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int    @id @default(autoincrement())
  // The login identifier. Required and unique - unlike the old optional
  // email field, this one always has a value (backfilled from the old
  // username on upgrade, see migration 20260804 for the cutover).
  email        String @unique
  // Display name shown throughout the UI (watch-buddy chips, "Angemeldet
  // als ..."), separate from the login email.
  name         String
  passwordHash String
  role         String @default("user") // "admin" | "user"
  // Set whenever an admin picks a user's initial/reset password on their
  // behalf - forces a self-service change on next login rather than letting
  // them keep using a password someone else chose.
  mustChangePassword Boolean              @default(false)
  // Opt-out for the "new episodes / show completed" digest email.
  notifyEmail        Boolean              @default(true)
  createdAt          DateTime             @default(now())
  mediaItems         MediaItem[]
  watchGroups        WatchGroupMember[]
  passwordResets     PasswordResetToken[]
}

// Single-use, time-limited tokens for the "forgot password" email flow.
// The raw token is only ever sent to the user's inbox - we store a SHA-256
// hash of it so a database read alone can't be used to reset an account.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Backing store for express-session so sessions survive container restarts.
model Session {
  sid       String   @id
  data      String
  expiresAt DateTime
}

model MediaItem {
  id            Int       @id @default(autoincrement())
  // Each user has their own independent list - a show tracked by two
  // friends is two separate rows (see WatchGroup for the "watching this
  // together" link between them).
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType     String // "movie" | "tv"
  tmdbId        Int
  tvdbId        Int?
  title         String
  originalTitle String?
  overview      String?
  posterPath    String?
  backdropPath  String?
  releaseDate   String?
  // TMDB's own production status for shows ("Returning Series", "Ended",
  // "Canceled", ...) - i.e. whether the series is finished or continues.
  tmdbStatus    String?
  inProduction  Boolean?
  lastAirDate   String?
  // Anime is a cross-cutting category rather than a TMDB media type: it's
  // derived at import time from the Animation genre plus Japanese origin.
  isAnime       Boolean   @default(false)
  status        String    @default("watchlist") // watchlist | watching | watched | dropped
  userRating    Float?
  notes         String?
  watched       Boolean   @default(false) // relevant for movies
  watchedAt     DateTime?
  kodiId        Int? // idMovie / idShow in the Kodi video library, once matched
  addedAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  episodes      Episode[]

  @@unique([userId, mediaType, tmdbId])
}

// A content item (identified by mediaType+tmdbId, independent of any one
// user's MediaItem row) that a group of users have agreed to watch together.
// Adding someone auto-imports the content into their own list too - see
// POST /api/media/:id/buddies.
model WatchGroup {
  id        Int                @id @default(autoincrement())
  mediaType String
  tmdbId    Int
  createdAt DateTime           @default(now())
  members   WatchGroupMember[]

  @@unique([mediaType, tmdbId])
}

model WatchGroupMember {
  id           Int        @id @default(autoincrement())
  watchGroupId Int
  watchGroup   WatchGroup @relation(fields: [watchGroupId], references: [id], onDelete: Cascade)
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([watchGroupId, userId])
}

model Episode {
  id            Int       @id @default(autoincrement())
  mediaItemId   Int
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasonNumber  Int
  episodeNumber Int
  title         String?
  overview      String?
  stillPath     String?
  voteAverage   Float?
  airDate       String?
  watched       Boolean   @default(false)
  watchedAt     DateTime?
  // When this row was created - lets the app tell a newly-aired episode
  // added by a later metadata refresh apart from episodes that came in with
  // the show's initial import (see hasNewEpisodes in routes/media.ts).
  discoveredAt  DateTime  @default(now())

  @@unique([mediaItemId, seasonNumber, episodeNumber])
}

model SyncLog {
  id           Int       @id @default(autoincrement())
  source       String // "kodi" | "metadata"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  itemsUpdated Int       @default(0)
  status       String    @default("running") // running | success | error
  message      String?
}
