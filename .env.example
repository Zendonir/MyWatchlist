# Copy this file to .env and fill in real values. Never commit .env.

# --- Core / security ---
# Random string used to sign session cookies. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Credentials for the initial admin account, created on first startup only.
# Change the password after first login is not currently a self-service UI
# feature - manage additional users via an admin account (Settings page /
# POST /api/users), or update this user's password by editing the DB.
APP_USERNAME=admin
APP_PASSWORD=

# Set to 0 if MyWatchlist is NOT running behind a reverse proxy (not
# recommended for external access). Leave at 1 when using the bundled Caddy
# setup or any other reverse proxy in front of it.
TRUST_PROXY=1

# --- Metadata sources ---
# TMDB: https://www.themoviedb.org/settings/api (either the v3 API key or a
# v4 read access token works; the access token is preferred if you have one)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# TVDB (optional, used for supplemental TV metadata):
# https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=

# --- Kodi MySQL video library (optional) ---
# Point this at Kodi's MySQL video database (NOT the Kodi machine itself) -
# see README for how to enable MySQL storage in Kodi and create a read-only
# database user for this app to use.
KODI_DB_HOST=
KODI_DB_PORT=3306
KODI_DB_USER=
KODI_DB_PASSWORD=
KODI_DB_NAME=MyVideos121
KODI_SYNC_CRON=*/30 * * * *

# Only change these if `docker compose logs` shows season/episode numbers
# from Kodi are not matching correctly - see README "Kodi-Sync" section.
# KODI_EPISODE_SEASON_COLUMN=c12
# KODI_EPISODE_NUMBER_COLUMN=c13

# --- Reverse proxy (only used by deploy/docker-compose.caddy.yml) ---
DOMAIN=
