# Copy this file to .env and fill in real values. Never commit .env.

# --- Core / security ---
# Random string used to sign session cookies. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Credentials for the initial admin account, created on first startup only.
# APP_EMAIL is also the login - it doesn't need to be a real, working
# address (only "forgot password"/notifications need that, both optional -
# see the Email section below). Every user (including ones an admin creates
# later) can change their own password any time under Settings. Users an
# admin creates or resets the password for are required to change it on
# their next login.
APP_EMAIL=admin@example.com
APP_NAME=Admin
APP_PASSWORD=

# Set to 0 if MyWatchlist is NOT running behind a reverse proxy (not
# recommended for external access). Leave at 1 when using the bundled Caddy
# setup or any other reverse proxy in front of it.
TRUST_PROXY=1

# --- Metadata sources ---
# TMDB: https://www.themoviedb.org/settings/api (either the v3 API key or a
# v4 read access token works; the access token is preferred if you have one)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# TVDB (optional, used for supplemental TV metadata):
# https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=

# --- Kodi MySQL video library (optional) ---
# Point this at Kodi's MySQL video database (NOT the Kodi machine itself) -
# see README for how to enable MySQL storage in Kodi and create a read-only
# database user for this app to use.
KODI_DB_HOST=
KODI_DB_PORT=3306
KODI_DB_USER=
KODI_DB_PASSWORD=
# Prefix only, NOT the full database name - Kodi appends its schema version
# (e.g. MyVideos121) and bumps that number on upgrades, often leaving older
# ones behind. The app looks at every database matching "<prefix><number>"
# on the server and automatically uses whichever has the highest number.
KODI_DB_NAME_PREFIX=MyVideos
# Default: once a day at 03:00. Cron syntax, e.g. "*/30 * * * *" for every
# 30 minutes if you want more frequent updates.
KODI_SYNC_CRON=0 3 * * *

# Only change these if `docker compose logs` shows season/episode numbers
# from Kodi are not matching correctly - see README "Kodi-Sync" section.
# KODI_EPISODE_SEASON_COLUMN=c12
# KODI_EPISODE_NUMBER_COLUMN=c13

# How often to check TMDB for newly-aired episodes of tracked shows and
# backfill any missing poster/overview data. Default: once a day at 03:30.
METADATA_REFRESH_CRON=30 3 * * *

# --- Email (optional): "forgot password" + new-episode/show-completed digest ---
# SMTP itself is entered from Settings -> E-Mail-Versand (SMTP), not env
# vars - see README "Email (optional)". APP_URL just needs to be set here so
# password-reset emails can link back into the app, e.g.
# https://watchlist.example.com or https://192.168.1.2:3000
APP_URL=

# --- Reverse proxy (only used by deploy/docker-compose.caddy.yml) ---
DOMAIN=

# --- LAN-only HTTPS (only used by deploy/docker-compose.caddy-lan.yml) ---
# This machine's LAN IP, e.g. 192.168.1.2 - baked into the self-signed
# certificate so the browser's hostname check passes.
LAN_IP=
