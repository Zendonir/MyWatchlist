# LAN-only HTTPS using a static self-signed certificate (generated once by
# the caddy service's entrypoint - see docker-compose.caddy-lan.yml - into
# /certs, which this file just loads). Static files instead of Caddy's own
# "tls internal" automatic issuance, which can fail with a TLS-level
# "internal error" during the handshake in some container environments.
#
# The very first visit shows a browser warning ("connection not private")
# because that self-signed cert isn't in your OS/browser trust store;
# click through it once ("Advanced -> proceed") and it works from then on.

:443 {
	tls /certs/cert.pem /certs/key.pem

	encode gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	reverse_proxy mywatchlist:3000
}

:80 {
	redir https://{host}{uri} permanent
}
